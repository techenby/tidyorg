{
    "name": "tidyorg/{{ key }}",
    "description": "Tidy Org module: {{ name }}.",
    "type": "tidyorg-module",
    "license": "AGPL-3.0-or-later",
    "require": {
        "php": "^8.3"
    },
    "autoload": {
        "psr-4": {
            "TidyOrg\\{{ studly }}\\": "src/",
            "TidyOrg\\{{ studly }}\\Database\\Factories\\": "database/factories/"
        }
    },
    "extra": {
        "laravel": {
            "providers": [
                "TidyOrg\\{{ studly }}\\{{ studly }}Module"
            ]
        }
    }
}

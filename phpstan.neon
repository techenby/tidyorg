includes:
    - vendor/larastan/larastan/extension.neon
    - vendor/nesbot/carbon/extension.neon

parameters:
    paths:
        - app/
        - bootstrap/app.php
        - config/
        - database/
        - modules/
        - routes/

    excludePaths:
        - modules/*/tests/*
        - modules/*/resources/*

    level: 7
